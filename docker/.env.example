# Copy to docker/.env (gitignored) and fill in. Read by docker/docker-compose.yml.

# Your ngrok static domain -- hostname only, no https://. Required for the verify profile:
# Inji Verify bakes it into the response_uri the conformance suite must reach.
PUBLIC_HOST=your-name.ngrok-free.dev

# Only for the `tunnel` profile, which runs ngrok inside the stack. Leave empty if you run
# `ngrok http --url=https://$PUBLIC_HOST 3000` on the host instead. Never commit this.
NGROK_AUTHTOKEN=

# Image versions. Defaults are what the baseline was recorded against.
VERIFY_TAG=1.0.0-alpha.1
# The suite is pinned by digest in docker-compose.yml. Override only to try another build:
# SUITE_DIGEST=sha256:...
# SUITE_NGINX_DIGEST=sha256:...
